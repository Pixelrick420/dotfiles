
    {
        "label": "lock",
        "action": "swaylock-plugin --command $HOME/.config/wlogout/lock-bg.sh",
        "text": "Lock",
        "keybind": "l"
    },
    {
        "label": "shutdown",
        "action": "systemctl poweroff",
        "text": "Shutdown",
        "keybind": "s"
    },
    {
        "label": "reboot",
        "action": "systemctl reboot",
        "text": "Reboot",
        "keybind": "r"
    }
