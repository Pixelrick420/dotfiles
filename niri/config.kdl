spawn-at-startup "swayidle" "-w" 
spawn-at-startup "dfr-theme-set-bg" "--keep-current"
spawn-at-startup "mako"
spawn-at-startup "elephant"
spawn-at-startup "walker" "--gapplication-service"
spawn-at-startup "mpd"
spawn-sh-at-startup "sleep 1; exec mpd-mpris"
spawn-at-startup "dfr-first-boot"
input {
    keyboard {
        xkb {
            options "altwin:menu_win"
        }
        repeat-delay 200
        repeat-rate 40
    }
    touchpad {
        tap
        natural-scroll
        accel-profile "flat"
    }
    mouse {
        accel-profile "flat"
        scroll-factor 2.0
    }
}
screenshot-path null
hotkey-overlay {
    skip-at-startup
}
gestures {
    hot-corners {
        off
    }
}
prefer-no-csd
layout {
    gaps 8
    default-column-width {
        proportion 0.5
    }
    preset-column-widths {
        proportion 0.33
        proportion 0.5
        proportion 0.66
    }
    focus-ring {
        width 1
    }
}
window-rule {
    match app-id="dev.zed.Zed"

    tiled-state true
    geometry-corner-radius 2
    clip-to-geometry true
}
window-rule {
    match app-id="^Pinentry-gtk$"
    match app-id="^Tk$"
    match app-id="^gimp$" title="Preferences"
    match app-id="^mpv$"
    match app-id="^soffice$" title="^Text Import"
    match app-id="^thunar$" title="^Rename "
    match app-id="^virt-manager$" title=" - Connection Details"
    match app-id="^wev$"
    match app-id="^xarchiver$"
    match app-id="firefox$" title="^(Picture-in-Picture|Library|About Mozilla Firefox|Firefox - Choose a profile)$"
    open-floating true
}
window-rule {
    match app-id="^dfr\\.floating\\.ghostty$"
    match app-id="^dfr\\.floating\\.thunar$"
    open-floating true
    default-column-width {
        proportion 0.33
    }
    default-window-height {
        proportion 0.5
    }
}
window-rule {
    match app-id="^com\\.gabm\\.satty$"
    open-floating true
    min-width 730
    min-height 300
}
window-rule {
    match app-id="^KeePassXC$"
    block-out-from "screencast"
}
binds {
    Mod+Grave hotkey-overlay-title="Kitty terminal" {
        spawn "~/.local/bin/kitty-focus"
    }
    Mod+Slash hotkey-overlay-title="Search niri keybinds" {
        spawn "walker" "--height" "980" "--width" "980" "--provider" "menus:keybinds"
    }
    Mod+Shift+Slash hotkey-overlay-title="Search niri actions" {
        spawn "walker" "--height" "980" "--width" "980" "--provider" "niriactions"
    }
    Mod+Ctrl+Slash hotkey-overlay-title="Search Waybar actions" {
        spawn "walker" "--height" "980" "--width" "800" "--provider" "menus:waybar"
    }
    Mod+O repeat=false hotkey-overlay-title="Toggle overview (4-finger swipe)" {
        toggle-overview
    }
    Mod+Alt+L hotkey-overlay-title="Lock screen" {
        spawn "swaylock-plugin" "--command" "$HOME/.config/wlogout/lock-bg.sh"
    }
    Mod+Shift+Alt+L hotkey-overlay-title="Power off monitors" {
        power-off-monitors
    }
    Mod+Ctrl+Shift+Q hotkey-overlay-title="Exit niri session" {
        quit
    }
    Mod+S hotkey-overlay-title="Screenshot (region)" {
        screenshot
    }
    Mod+Shift+S hotkey-overlay-title="Screenshot (window)" {
        screenshot-window
    }
    Mod+Ctrl+S hotkey-overlay-title="Screenshot (monitor: focused)" {
        screenshot-screen
    }
    Mod+P {
        spawn "wlogout" "-b" "3"
    }
    Mod+Shift+P hotkey-overlay-title="Pick color" {
        spawn-sh "killall hyprpicker || hyprpicker --autocopy --lowercase-hex"
    }
    Mod+E hotkey-overlay-title="Cast focused window" {
        spawn-sh "niri msg action set-dynamic-cast-window --id $(niri msg --json focused-window | jq .id)"
    }
    Mod+N hotkey-overlay-title="Show last notification" {
        spawn "makoctl" "restore"
    }
    Mod+Shift+N hotkey-overlay-title="Dismiss last notification" {
        spawn "makoctl" "dismiss"
    }
    Mod+Ctrl+N hotkey-overlay-title="Dismiss all notifications" {
        spawn "makoctl" "dismiss" "--all"
    }
    Mod+Ctrl+Shift+N hotkey-overlay-title="Toggle silencing notifications" {
        spawn "dfr-toggle-notifications"
    }
    Mod+BackSlash hotkey-overlay-title="Cycle theme's wallpapers" {
        spawn "dfr-theme-set-bg"
    }
    Mod+Shift+BackSlash hotkey-overlay-title="Pick theme's wallpapers" {
        spawn "dfr-theme-set-bg" "--menu"
    }
    Mod+Ctrl+BackSlash hotkey-overlay-title="Cycle themes" {
        spawn "dfr-theme-set"
    }
    Mod+Ctrl+Shift+BackSlash hotkey-overlay-title="Pick theme" {
        spawn "dfr-theme-set" "--menu"
    }
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Raise volume" {
        spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05+"
    }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Lower volume" {
        spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"
    }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Mute playback" {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"
    }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Mute microphone" {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"
    }
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Play / pause track" {
        spawn "playerctl" "play-pause"
    }
    XF86AudioStop allow-when-locked=true hotkey-overlay-title="Stop track" {
        spawn "playerctl" "stop"
    }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Previous track" {
        spawn "playerctl" "previous"
    }
    XF86AudioNext allow-when-locked=true hotkey-overlay-title="Next track" {
        spawn "playerctl" "next"
    }
    Shift+XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Seek -10 seconds" {
        spawn "playerctl" "position" "10-"
    }
    Shift+XF86AudioNext allow-when-locked=true hotkey-overlay-title="Seek +10 seconds" {
        spawn "playerctl" "position" "10+"
    }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Increase brightness" {
        spawn "brightnessctl" "--class=backlight" "set" "+5%"
    }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Decrease brightness" {
        spawn "brightnessctl" "--class=backlight" "set" "5%-"
    }
    Ctrl+XF86MonBrightnessUp {
        spawn "brightnessctl" "--class=backlight" "set" "+1%"
    }
    Ctrl+XF86MonBrightnessDown {
        spawn "brightnessctl" "--class=backlight" "set" "1%-"
    }
    XF86Calculator repeat=false hotkey-overlay-title="Calculator" {
        spawn "gnome-calculator"
    }
    Mod+Space {
        spawn "fuzzel"
    }
    Mod+W repeat=false hotkey-overlay-title="Launcher (windows)" {
        spawn "walker" "--provider" "windows"
    }
    Mod+V repeat=false hotkey-overlay-title="Launcher (clipboard)" {
        spawn "walker" "--provider" "clipboard"
    }
    Mod+Alt+H hotkey-overlay-title="System health" {
        spawn "dfr-launch-or-focus-tui" "monitor"
    }
    Mod+Alt+T hotkey-overlay-title="Terminal" {
        spawn "ghostty"
    }
    Mod+Alt+Shift+T hotkey-overlay-title="Terminal (floating)" {
        spawn "ghostty" "--class=dfr.floating.ghostty"
    }
    Mod+Alt+F hotkey-overlay-title="File manager" {
        spawn "thunar"
    }
    Mod+Alt+Shift+F hotkey-overlay-title="File manager (floating)" {
        spawn "thunar" "--name=dfr.floating.thunar"
    }
    Mod+Alt+N hotkey-overlay-title="Notes" {
        spawn "dfr-launch-or-focus-tui" "notes"
    }
    Mod+Alt+Shift+N hotkey-overlay-title="Notes (directory)" {
        spawn-sh "dfr-launch-or-focus-tui ${EDITOR} ${NOTES_DIRECTORY}"
    }
    Mod+Alt+P hotkey-overlay-title="Passwords" {
        spawn "dfr-launch-or-focus" "keepassxc"
    }
    Mod+Alt+Shift+P hotkey-overlay-title="Generate random password to clipboard" {
        spawn "pw"
    }
    Mod+Alt+M hotkey-overlay-title="Music" {
        spawn "dfr-launch-or-focus-tui" "rmpc"
    }
    Mod+Alt+B hotkey-overlay-title="Browser" {
        spawn "firefox"
    }
    Mod+Alt+Shift+B hotkey-overlay-title="Browser (private)" {
        spawn "firefox" "-private-window"
    }
    Mod+Alt+Ctrl+Shift+B hotkey-overlay-title="Browser (isolated profile)" {
        spawn-sh "firefox -P ${BROWSER_ISOLATED_PROFILE:-isolated}"
    }
    Mod+Ctrl+Shift+Equal hotkey-overlay-title="Increase focused monitor scale" {
        spawn "output-scale" "+"
    }
    Mod+Ctrl+Shift+Minus hotkey-overlay-title="Decrease focused monitor scale" {
        spawn "output-scale" "-"
    }
    Mod+Ctrl+Shift+0 hotkey-overlay-title="Reset focused monitor scale" {
        spawn "output-scale" "1.0"
    }
    Mod+Q repeat=false hotkey-overlay-title="Close window" {
        spawn "~/.local/bin/niri-close"
    }
    Mod+Shift+Q repeat=false hotkey-overlay-title="Kill window" {
        spawn "sh" "-c" "kill $(niri msg -j focused-window | jq -r .pid)"
    }
    Mod+C hotkey-overlay-title="Center column" {
        center-column
    }
    Mod+Ctrl+C hotkey-overlay-title="Center all visible columns" {
        center-visible-columns
    }
    Mod+Z hotkey-overlay-title="Toggle floating window" {
        toggle-window-floating
    }
    Mod+Ctrl+Z hotkey-overlay-title="Switch focus between floating and tiling" {
        switch-focus-between-floating-and-tiling
    }
    Mod+T hotkey-overlay-title="Toggle tabbed column" {
        toggle-column-tabbed-display
    }
    Mod+BracketLeft hotkey-overlay-title="Move focused window in and out of column to the left" {
        consume-or-expel-window-left
    }
    Mod+BracketRight hotkey-overlay-title="Move focused window in and out of column to the right" {
        consume-or-expel-window-right
    }
    Mod+F hotkey-overlay-title="Maximize column" {
        maximize-column
    }
    Mod+Return hotkey-overlay-title="Toggle fullscreen" {
        fullscreen-window
    }
    Mod+Ctrl+F hotkey-overlay-title="Fill empty column space" {
        expand-column-to-available-width
    }
    Mod+R hotkey-overlay-title="Cycle preset widths" {
        switch-preset-column-width
    }
    Mod+Shift+R hotkey-overlay-title="Cycle preset heights" {
        switch-preset-window-height
    }
    Mod+Ctrl+R hotkey-overlay-title="Reset window height" {
        reset-window-height
    }
    Mod+Period hotkey-overlay-title="Increase column width" {
        set-column-width "+5%"
    }
    Mod+Comma hotkey-overlay-title="Decrease column width" {
        set-column-width "-5%"
    }
    Mod+Shift+Equal hotkey-overlay-title="Increase window height" {
        set-window-height "+10%"
    }
    Mod+Shift+Minus hotkey-overlay-title="Decrease window height" {
        set-window-height "-10%"
    }
    Mod+I hotkey-overlay-title="Focus previously focused window" {
        focus-window-previous
    }
    Mod+Left hotkey-overlay-title="Focus column left" {
        focus-column-left
    }
    Mod+Down hotkey-overlay-title="Focus column down" {
        focus-window-down
    }
    Mod+Up hotkey-overlay-title="Focus column up" {
        focus-window-up
    }
    Mod+Right hotkey-overlay-title="Focus column right" {
        focus-column-right
    }
    Mod+H hotkey-overlay-title="Focus column left" {
        focus-column-left
    }
    Mod+J hotkey-overlay-title="Focus column down" {
        focus-window-down
    }
    Mod+K hotkey-overlay-title="Focus column up" {
        focus-window-up
    }
    Mod+L hotkey-overlay-title="Focus column down" {
        focus-column-right
    }
    Mod+Shift+Left hotkey-overlay-title="Move column left" {
        move-column-left
    }
    Mod+Shift+Down hotkey-overlay-title="Move column down" {
        move-window-down
    }
    Mod+Shift+Up hotkey-overlay-title="Move column up" {
        move-window-up
    }
    Mod+Shift+Right hotkey-overlay-title="Move column right" {
        move-column-right
    }
    Mod+Ctrl+H hotkey-overlay-title="Move column left" {
        move-column-left
    }
    Mod+Ctrl+J hotkey-overlay-title="Move column down" {
        move-window-down
    }
    Mod+Ctrl+K hotkey-overlay-title="Move column up" {
        move-window-up
    }
    Mod+Ctrl+L hotkey-overlay-title="Move column down" {
        move-column-right
    }
    Mod+G hotkey-overlay-title="Focus first column" {
        focus-column-first
    }
    Mod+SemiColon hotkey-overlay-title="Focus last column" {
        focus-column-last
    }
    Mod+Ctrl+G hotkey-overlay-title="Move column to first" {
        move-column-to-first
    }
    Mod+Ctrl+SemiColon hotkey-overlay-title="Move column to last" {
        move-column-to-last
    }
    Mod+Home hotkey-overlay-title="Focus first column" {
        focus-column-first
    }
    Mod+End hotkey-overlay-title="Focus last column" {
        focus-column-last
    }
    Mod+Ctrl+Home hotkey-overlay-title="Move column to first" {
        move-column-to-first
    }
    Mod+Ctrl+End hotkey-overlay-title="Move column to last" {
        move-column-to-last
    }
    Mod+WheelScrollDown hotkey-overlay-title="Focus column right" {
        focus-column-right
    }
    Mod+WheelScrollUp hotkey-overlay-title="Focus column left" {
        focus-column-left
    }
    Mod+Ctrl+WheelScrollDown hotkey-overlay-title="Move column right" {
        move-column-right
    }
    Mod+Ctrl+WheelScrollUp hotkey-overlay-title="Move column left" {
        move-column-left
    }
    Mod+WheelScrollRight hotkey-overlay-title="Focus column right" {
        focus-column-right
    }
    Mod+WheelScrollLeft hotkey-overlay-title="Focus column left" {
        focus-column-left
    }
    Mod+Ctrl+WheelScrollRight hotkey-overlay-title="Move column right" {
        move-column-right
    }
    Mod+Ctrl+WheelScrollLeft hotkey-overlay-title="Move column left" {
        move-column-left
    }
    Mod+Ctrl+Shift+Left hotkey-overlay-title="Move column to left monitor" {
        move-column-to-monitor-left
    }
    Mod+Ctrl+Shift+Down hotkey-overlay-title="Move column to lower monitor" {
        move-column-to-monitor-down
    }
    Mod+Ctrl+Shift+Up hotkey-overlay-title="Move column to upper monitor" {
        move-column-to-monitor-up
    }
    Mod+Ctrl+Shift+Right hotkey-overlay-title="Move column to right monitor" {
        move-column-to-monitor-right
    }
    Mod+Ctrl+Shift+H hotkey-overlay-title="Move column to left monitor" {
        move-column-to-monitor-left
    }
    Mod+Ctrl+Shift+J hotkey-overlay-title="Move column to lower monitor" {
        move-column-to-monitor-down
    }
    Mod+Ctrl+Shift+K hotkey-overlay-title="Move column to upper monitor" {
        move-column-to-monitor-up
    }
    Mod+Ctrl+Shift+L hotkey-overlay-title="Move column to right monitor" {
        move-column-to-monitor-right
    }
    Mod+MouseBack hotkey-overlay-title="Focus left monitor" {
        focus-monitor-left
    }
    Mod+MouseForward hotkey-overlay-title="Focus right monitor" {
        focus-monitor-right
    }
    Mod+Ctrl+Shift+MouseBack hotkey-overlay-title="Move column to left monitor" {
        move-column-to-monitor-left
    }
    Mod+Ctrl+Shift+MouseForward hotkey-overlay-title="Move column to right monitor" {
        move-column-to-monitor-right
    }
    Mod+Shift+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="Focus next workspace" {
        focus-workspace-down
    }
    Mod+Shift+WheelScrollUp cooldown-ms=150 hotkey-overlay-title="Focus previous workspace" {
        focus-workspace-up
    }
    Mod+Ctrl+Shift+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="Move column to next workspace" {
        move-column-to-workspace-down
    }
    Mod+Ctrl+Shift+WheelScrollUp cooldown-ms=150 hotkey-overlay-title="Move column to previous workspace" {
